# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# data files - all databases, CSVs, and data directories
data/*.db
data/*.db-*
data/**/*.csv
data/**/*.json
dataold/
scripts/

# python virtual environment
venv/
*.pyc
__pycache__/
.python-version
*.backup-*

# Kiro workspace settings (contains local DB credentials)
.kiro/settings/mcp.json

# Database dumps
*.dump
*.sql.gz

# Scripts with hardcoded credentials (use env vars instead)
scripts/push-to-neon.py
scripts/sync-macro-framework.py
scripts/fix-equity-series.py
